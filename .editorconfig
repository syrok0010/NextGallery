root = true

[*.{kt,kts}]
ktlint_code_style = android_studio
ktlint_standard_binary-expression-wrapping = disabled
ktlint_standard_expression-operand-wrapping = enabled
ktlint_standard_chain-method-continuation = enabled
ktlint_chain_method_rule_force_multiline_when_chain_operator_count_greater_or_equal_than = unset
ktlint_function_signature_body_expression_wrapping = multiline
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_function_naming_ignore_when_annotated_with = Composable
# Только форматирование: не переименовываем объявления и не меняем политику imports.
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_filename = disabled
